{
  "name": "metrion",
  "version": "0.5.0",
  "private": true,
  "description": "A small multi-tenant metrics platform: any application, in any language, POSTs numbers to one authenticated ingest endpoint, which writes them to Postgres/TimescaleDB; a viewer reads them back as charts.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.19"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "applications/agent",
    "applications/ingest",
    "applications/viewer",
    "applications/viewer/client",
    "applications/evaluator"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
