# Metrion ingest service - see docs/adr/0004-postgres-timescaledb-over-append-blob.md
# for why this replaced the old Azure Blob sink, and
# docs/adr/0005-api-key-determines-tenancy.md for the key format/scoping.
METRION_INGEST_URL=https://metrion-ingest.<domain>/api/v1/ingest
METRION_API_KEY=mtr_<prefix>_<secret>
METRION_SEND_TIMEOUT_MS=10000

# Docker Engine API, read-only (GET only - see src/lib/docker-socket.ts).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# The container whose stdout carries Caddy's JSON access log.
CADDY_CONTAINER_NAME=portfolio-caddy-1

# Where the queue (undelivered samples) and small state files live.
COLLECTOR_STATE_DIR=/var/lib/vps-metrics-collector
COLLECTOR_QUEUE_MAX_LINES=1440
COLLECTOR_QUEUE_FLUSH_BUDGET_MS=15000

# Overrides os.hostname() in the emitted sample - usually left unset.
COLLECTOR_HOST_OVERRIDE=

# Skips the ingest send entirely (logs the sample to stdout instead) - the
# one way to run this locally without a real API key. Never set on the
# server unit.
DRY_RUN=false
