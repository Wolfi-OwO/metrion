{
  "name": "@metrion/viewer",
  "version": "0.5.0",
  "private": true,
  "description": "Serves the read API the chart client runs on, scoped per project, against the TimescaleDB hypertable @metrion/db migrates. Writing metrics is done through the separate @metrion/ingest service.",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.ts"
  },
  "dependencies": {
    "@metrion/db": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "openid-client": "^6.8.8",
    "pino": "^9.14.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@metrion/shared": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.7.2"
  }
}
