# HTTP port the viewer listens on.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Postgres/TimescaleDB connection string. Required - unlike @metrion/ingest,
# which leaves this to @metrion/db's own local-dev fallback, the viewer fails
# to boot without a real value (config/index.ts's requireEnv). Matches
# docker-compose.dev.yml for local dev: postgres://metrion:metrion@localhost:5432/metrion
# Production connects as `metrion_app`, a least-privilege role
# (packages/db/migrations/0005_least_privilege_app_role.sql) - never the
# `metrion` superuser, which is reserved for the migration runner.
DATABASE_URL=

# Rate limit across the whole app, all callers together. This is now the
# app's only rate limiter - POST /api/v1/ingest moved to @metrion/ingest,
# which keys its own limiter on the API key instead.
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Comma-separated browser origins allowed to call the API, e.g.
# https://metrion.example.at. Required, not optional any more: GET /api/v1/me
# and the project/key endpoints read a session cookie (issue #7), so an
# unrestricted origin would let a page nobody owns ride a signed-in
# visitor's cookie.
CORS_ALLOWED_ORIGINS=

# The ONLY place a redirect base is derived from - every OAuth redirect_uri
# this app builds is ${PUBLIC_BASE_URL}/auth/<provider>/callback. Phase 1:
# the Container Apps FQDN, e.g. https://metrion-viewer.example.azurecontainerapps.io
PUBLIC_BASE_URL=

# HMAC key that signs the opaque session cookie value (auth/session.ts). A
# long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Google sign-in. Redirect URI to register at the provider:
# ${PUBLIC_BASE_URL}/auth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Entra ID / personal Microsoft accounts). Redirect URI:
# ${PUBLIC_BASE_URL}/auth/microsoft/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# `common` accepts both personal and work/school accounts. Unset defaults to it.
OAUTH_MICROSOFT_TENANT=common

# GitHub sign-in. Redirect URI: ${PUBLIC_BASE_URL}/auth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
